# Copy this file to .env and change what you need. Everything has a working default.

# Login tokens are signed with this. Leave empty and the app makes one in app_data/.
# To make your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where data is kept:
#   local  - no database server needed; saved to app_data/local_db.json (default)
#   mongo  - a MongoDB server, set MONGO_URI below
AGRI_DB=local
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agriexpert

# Optional: Google Gemini for open-ended questions in the farmer's language.
# Get a key at https://aistudio.google.com/apikey . Without it the built-in assistant answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional: today's mandi prices from data.gov.in (free key at https://data.gov.in).
# Without it, market prices are estimated from past Agmarknet reports.
DATA_GOV_API_KEY=

# live = 7-day forecast from Open-Meteo (free, no key). offline = use district rainfall normals only.
WEATHER_MODE=live

PORT=5050
